digraph AFD_Simple {
rankdir=LR;
node [shape=circle];
  graph [labelloc=t, label="Automata: AFD_Simple\nTipo: Automata Finito Determinista\nEstados: [S, F]\nAlfabeto: [0, 1]\nEstado Inicial: S\nEstados de Aceptación: [F]\nTransiciones: S -> 0, F | 1, S |  
 	 	F -> 0, F | 1, S |  
 	 	S -> 0, F | 1, S |  
 	 	F -> 0, F | 1, S |  
 	 	", fontsize=18];
  _ini [shape=point,label=""];
 _ini -> "S";
  "F" [shape=doublecircle];
  "S" -> "F" [label="0"];
  "S" -> "S" [label="1"];
  "F" -> "F" [label="0"];
  "F" -> "S" [label="1"];
}
