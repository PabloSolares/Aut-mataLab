package Lexer;
import java_cup.runtime.Symbol;
import java.util.ArrayList;
import Modelo.AFD;
import Modelo.AP;
import Modelo.Automata;


import Lexer.AFDContent;
import Lexer.APContent;

parser code  
{:
    public static javax.swing.JTextArea textAreaSalida;
    
    public static ArrayList<Automata> listaAutomatas = new ArrayList<>();
    public static boolean skipCurrentDeclaration = false;

    public ArrayList<Automata> getlistaAutomatas(){
        return listaAutomatas;
    }

    
    public void syntax_error(Symbol s){
        String lexeme = (s.value != null) ? s.value.toString() : "EOF";
        
        Modelo.ModeloMenu.ListaErrores.add(new Modelo.Errors("Sintactico - Recuperado", lexeme, s.left+1 , s.right));
        
    }

    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception {
        String lexeme = (s.value != null) ? s.value.toString() : "EOF";
        Modelo.ModeloMenu.ListaErrores.add(new Modelo.Errors("Sintactico - Sin recuperacion", lexeme, s.left+1 , s.right));
    }

:};
action code
{::};
terminal String ID;
terminal String INTEGER;
terminal String HASTAG;
terminal String DOLLAR;
terminal String STRING;
terminal R_VERAUTOMATAS;
terminal R_DESAUTOMATAS;




 
terminal LESS, R_AFD, R_NAME, EQUAL, GREATHER, COLON,R_AP, KEY_OPEN, KEY_CLOSE, SEMICOLON, PROD, OR, CLOSE, R_TRANSICIONES, PAR_OPEN, PAR_CLOSE , COMMA, DOT,QUOTATION,ERROR ;
non terminal PROGRAM, Syntax_AP_P , AFD_CLOSE, Syntax_AP, AP_CLOSE ;


non terminal ArrayList<String> LIST_IDS;
non terminal String STATE_ASSING;
non terminal ArrayList<String> STATE_ASIGNP;
non terminal ArrayList<ArrayList<String>> LIST_TRANSATIONS;
non terminal ArrayList<ArrayList<String>> LIST_TRANSACTIONSP;
non terminal ArrayList<String> LIST_ID_TRANSACTIONS;
non terminal ArrayList<String> ID_TRANSACTIONS;
non terminal ArrayList<String> LIST_FOLLOWS;
non terminal ArrayList<String> LIST_OR_BEFORE;
non terminal String STATE_FOLLOWS;
non terminal ArrayList<String> STATE_FOLLOWSP;
non terminal AFD AFD_DECLARACION;
non terminal ArrayList<String[]> LIST_CONFIG;
non terminal ArrayList<String[]> LIST_CONFIGP;
non terminal ArrayList<String[]> LIST_AFD;
non terminal String[] ID_ASIGN;

non terminal AFDContent CONTENT_AFD;
non terminal APContent  CONTENT_AP;
non terminal ArrayList<String> LIST_STACK_AP;
non terminal ArrayList<String> LIST_STACKP_AP;
non terminal ArrayList<String> STATE_STACK_AP;

non terminal ArrayList<ArrayList<String>> LIST_TRANSATIONS_AP;
non terminal ArrayList<ArrayList<String>> LIST_TRANSACTIONSP_AP;
non terminal ArrayList<ArrayList<String>> LIST_ID_TRANSACTIONS_AP;
non terminal ArrayList<ArrayList<String>> ID_TRANSACTIONS_AP;
non terminal ArrayList<ArrayList<String>> LIST_OR_BEFORE_AP;
non terminal String SYMBOLS;
non terminal VER_AUTOMATAS;
non terminal SYNTAX_COMPLETE;
non terminal PROGRAM_COMPLETE;
non terminal PROGRAM_Syntax;
non terminal DES_AUTOMATAS;
non terminal VAL_AUTOMATA;

start with PROGRAM;


PROGRAM ::= PROGRAM_Syntax
;

PROGRAM_Syntax ::= SYNTAX_COMPLETE
;

SYNTAX_COMPLETE ::= SYNTAX_COMPLETE PROGRAM_COMPLETE | PROGRAM_COMPLETE
;

PROGRAM_COMPLETE ::= Syntax_AP_P | AFD_DECLARACION | VER_AUTOMATAS | DES_AUTOMATAS | VAL_AUTOMATA
| error PROGRAM_COMPLETE
;

DES_AUTOMATAS ::= R_DESAUTOMATAS PAR_OPEN ID:nombre PAR_CLOSE SEMICOLON
{:
    boolean exists = sintax.listaAutomatas.stream()
            .anyMatch(a -> a.getNombre().equals(nombre));
    if(!exists){
        sintax.textAreaSalida.append("El automata ingresado no existe " + "\n");
    }else{
    
    for(Automata automata : sintax.listaAutomatas){
        if (automata.getNombre().equals(nombre)){
            sintax.textAreaSalida.append(
            "Nombre: " + automata.getNombre() + "\n" +
            "\t" + "Tipo: " + automata.getTipo() + "\n"+
            "\t" + "Estados: " + automata.getEstados() + "\n"+
            "\t" + "Estado Inicial: " + automata.getEstadoInicial() + "\n"+
            "\t" + "Alfabeto: " + automata.getAlfabeto() + "\n"+
            "\t" + "Estados de Aceptacion: " + automata.getEstadosAceptacion() + "\n" +
            "\t" + "Transiciones: " +  automata.getTrancisiones() + "\n"
            );
        }
    }
}
    sintax.textAreaSalida.append("---------------------------------------------------------------------------------" + "\n");
:}
;

VER_AUTOMATAS ::= R_VERAUTOMATAS PAR_OPEN PAR_CLOSE SEMICOLON
{:
    
    for(Automata automata : sintax.listaAutomatas){
        sintax.textAreaSalida.append(automata.getNombre() +  "\t" + automata.getTipo() + "\n");
    }
    sintax.textAreaSalida.append("---------------------------------------------------------------------------------" + "\n");
:}

;
VAL_AUTOMATA ::= ID:nombre PAR_OPEN STRING:cadena PAR_CLOSE SEMICOLON
{:
    
    boolean exists = sintax.listaAutomatas.stream()
            .anyMatch(a -> a.getNombre().equals(nombre));
    if(exists && !cadena.isEmpty() && !cadena.equals("")){
        for(Automata automata : sintax.listaAutomatas){
            if (automata.getNombre().equals(nombre)){
                if(automata.validate(cadena.substring(1, cadena.length() - 1))){

                    sintax.textAreaSalida.append(nombre +  "\t" + cadena +  "\t"  + "Cadena Valida" + "\n");

                } else {

                    sintax.textAreaSalida.append(nombre +  "\t" + cadena +  "\t"  + "Cadena NO Valida" + "\n");
                }

                 try {
                       if(automata instanceof AFD){
                           ((AFD) automata).exportarGraficaValidar(java.nio.file.Paths.get("REPORTE" + nombre + " - " + cadena.substring(1, cadena.length() - 1)), cadena.substring(1, cadena.length() - 1));
                           sintax.textAreaSalida.append("Grafico generado correctamente \n");
                       } 

                        if(automata instanceof AP){
                           ((AP) automata).exportarGrafica(java.nio.file.Paths.get("REPORTE" + nombre + " - " + cadena.substring(1, cadena.length() - 1)), cadena.substring(1, cadena.length() - 1));
                           sintax.textAreaSalida.append("Grafico generado correctamente \n");
                       } 


                   } catch (Exception e){
                       sintax.textAreaSalida.append("Error en generar el grafico \n");
                       e.printStackTrace();
                    }
                    sintax.textAreaSalida.append("---------------------------------------------------------------------------------" + "\n");

            }
        }
    } else {
        sintax.textAreaSalida.append("Automata No existe o la cadena no es valida" + "\n");
        sintax.textAreaSalida.append("---------------------------------------------------------------------------------" + "\n");
    }
:}
;
Syntax_AP_P ::= Syntax_AP
;
AFD_DECLARACION ::= LESS R_AFD R_NAME EQUAL STRING:nombre GREATHER CONTENT_AFD:contenido AFD_CLOSE
{:  
     if (sintax.skipCurrentDeclaration) {
        sintax.skipCurrentDeclaration = false;
        RESULT = null;
    }else {
    
    Boolean flag = false;
    if (contenido == null || contenido.getEstados().isEmpty() || contenido.getAlfabeto().isEmpty() || contenido.getEstadosAceptacion().isEmpty() || contenido.getEstadoInicial() == null || contenido.getTransiciones().isEmpty()){
        Modelo.ModeloMenu.ListaErrores.add(
                new Modelo.Errors("Sintactico", 
                    "El AFD '" + nombre + "' no pudo ser creado revisa en: ", 
                    nombreleft, nombreright)
            );
        flag = true;
        RESULT = null;
    }

    boolean exists = sintax.listaAutomatas.stream()
            .anyMatch(a -> a.getNombre().equals(nombre.substring(1, nombre.length() - 1)));
    
    if(exists){
        Modelo.ModeloMenu.ListaErrores.add(
                new Modelo.Errors("Sintactico", 
                    "El nombre del AFD '" + nombre + "' ya esta en uso", 
                    nombreleft, nombreright)
            );
        RESULT = null;
    } else if (!flag) {
        AFD afd = new AFD();
        afd.setNombre(nombre.substring(1, nombre.length() - 1));
        afd.setTipo("Automata Finito Determinista");

        
        for (String e: contenido.getEstados()){

            afd.addEstado(e);
        }

        for (String a: contenido.getAlfabeto()){
            afd.addAlfabeto(a);
        }

        afd.setEstadoInicial(contenido.getEstadoInicial());

        for (String ea: contenido.getEstadosAceptacion()){
            afd.addEstadoAcept(ea);
        }
        
        for(ArrayList<String> tr : contenido.getTransiciones()){

            String origen = tr.get(0);

            for(int i = 1; i< tr.size(); i+=2){
                String simbolo = tr.get(i);
                String destino = tr.get(i+1);


                afd.addTransicion(origen, simbolo, destino);
            }
        }
        
        sintax.listaAutomatas.add(afd);
        
        RESULT = afd;
        sintax.textAreaSalida.append("AUTOMATA AFD " + (nombre.substring(1, nombre.length() - 1)) + " creado correctamente"+"\n");
         sintax.textAreaSalida.append(
            "Nombre: " + afd.getNombre() + "\n" +
            "\t" + "Tipo: " + afd.getTipo() + "\n"+
            "\t" + "Estados: " + afd.getEstados() + "\n"+
            "\t" + "Estado Inicial: " + afd.getEstadoInicial() + "\n"+
            "\t" + "Alfabeto: " + afd.getAlfabeto() + "\n"+
            "\t" + "Estados de Aceptacion: " + afd.getEstadosAceptacion() + "\n" +
            "\t" + "Transiciones: " +  afd.getTrancisiones() + "\n"
            );
        try {
           afd.exportarGrafica(java.nio.file.Paths.get("REPORTE" + nombre.substring(1, nombre.length() - 1)));
           sintax.textAreaSalida.append("Grafico generado correctamente \n");
       } catch (Exception e){
           sintax.textAreaSalida.append("Error en generar el grafico \n");
           e.printStackTrace();
        }
        sintax.textAreaSalida.append("---------------------------------------------------------------------------------" + "\n");
        
                
    } else {
        RESULT = null;
    }
    
    }
:}

;

Syntax_AP ::= LESS R_AP R_NAME EQUAL STRING:nombre GREATHER CONTENT_AP:contenido AP_CLOSE
{:  
    if (sintax.skipCurrentDeclaration) {
        sintax.skipCurrentDeclaration = false;
        RESULT = null;
    }else {
    Boolean flag = false;
    if (contenido == null || contenido.getEstados().isEmpty() || contenido.getAlfabeto().isEmpty() || contenido.getEstadosAceptacion().isEmpty() || contenido.getEstadoInicial() == null || contenido.getTransiciones().isEmpty() || contenido.getSimboloPila().isEmpty()){
        Modelo.ModeloMenu.ListaErrores.add(
                new Modelo.Errors("Sintactico", 
                    "El AP '" + nombre + "' no pudo ser creado revisa en: ", 
                    nombreleft, nombreright)
            );
        flag = true;
        RESULT = null;
    }

    boolean exists = sintax.listaAutomatas.stream()
            .anyMatch(a -> a.getNombre().equals(nombre.substring(1, nombre.length() - 1)));
    
    if(exists){
        Modelo.ModeloMenu.ListaErrores.add(
                new Modelo.Errors("Sintactico", 
                    "El nombre del AP '" + nombre + "' ya esta en uso", 
                    nombreleft, nombreright)
            );
        RESULT = null;
    } else if (!flag) {
        AP ap = new AP();
        ap.setNombre(nombre.substring(1, nombre.length() - 1));
        ap.setTipo("Automata de Pila");

        for (String e: contenido.getEstados()){

            ap.setEstados(e);
        }

        for (String a: contenido.getAlfabeto()){
            ap.setAlfabeto(a);
        }

        ap.setEstadoInicial(contenido.getEstadoInicial());

        for (String ea: contenido.getEstadosAceptacion()){
            ap.setEstadosAceptacion(ea);
        }

        for (String sp: contenido.getSimboloPila()){
            ap.setSimbolosPila(sp);
        }

        for(ArrayList<String> tr : contenido.getTransiciones()){
            
           
            String origen = tr.get(0);
            
            for(int i = 1; i< tr.size(); i+=4){
                String simboloEntrada = tr.get(i);
                
                String simboloExtrae = tr.get(i+1);
                String estadoDestino = tr.get(i+2);
                String SimboloInserta = tr.get(i+3);
               
                



                ap.setTrancisiones(origen, simboloEntrada, simboloExtrae,estadoDestino,SimboloInserta);
            }
           
        }
        
        sintax.listaAutomatas.add(ap);
        RESULT = ap;

        sintax.textAreaSalida.append("AUTOMATA AP " + (nombre.substring(1, nombre.length() - 1)) + " creado correctamente"+"\n");
         sintax.textAreaSalida.append(
            "Nombre: " + ap.getNombre() + "\n" +
            "\t" + "Tipo: " + ap.getTipo() + "\n"+
            "\t" + "Estados: " + ap.getEstados() + "\n"+
            "\t" + "Estado Inicial: " + ap.getEstadoInicial() + "\n"+
            "\t" + "Alfabeto: " + ap.getAlfabeto() + "\n"+
            "\t" + "Estados de Aceptacion: " + ap.getEstadosAceptacion() + "\n" +
            "\t" + "Transiciones: " +  ap.getTrancisiones() + "\n" +
            "\t" + "Simbolos de pila: " +  ap.getSimbolosPila() + "\n"

            );
        try {
           ap.exportarGraficaAP(java.nio.file.Paths.get("REPORTE" + nombre.substring(1, nombre.length() - 1)));
           sintax.textAreaSalida.append("Grafico generado correctamente \n");
       } catch (Exception e){
           sintax.textAreaSalida.append("Error en generar el grafico \n");
           e.printStackTrace();
        }
        sintax.textAreaSalida.append("---------------------------------------------------------------------------------" + "\n");
    } else {
        RESULT = null;
    }
    }
    
:}

;
CONTENT_AFD ::= LIST_CONFIG:cfga  R_TRANSICIONES COLON LIST_TRANSATIONS:listT
{:
    
    AFDContent content = new AFDContent();
    for(String[] cfg : cfga){
       
        String tipo = cfg[0];
        ArrayList<String> lista = new ArrayList<>();
        for(int i = 1; i < cfg.length; i++){
            lista.add(cfg[i]);
        } 
        switch(tipo) {
            case "N": content.getEstados().addAll(lista);  break;
            case "T": content.getAlfabeto().addAll(lista); break;
            case "I": content.setEstadoInicial(lista.get(0));break;
            case "A": content.getEstadosAceptacion().addAll(lista); break;
        }
    }

    for (ArrayList<String> t : listT ){
       
        content.addTransicion(t);
    }
    RESULT = content;
    
:}

;
CONTENT_AP ::= LIST_CONFIG:lcg  R_TRANSICIONES COLON LIST_TRANSATIONS_AP:listAP
{:
    
    APContent contentAP = new APContent();
    for(String[] cfg : lcg){
       
        String tipo = cfg[0];
        ArrayList<String> lista = new ArrayList<>();
        for(int i = 1; i < cfg.length; i++){
            lista.add(cfg[i]);
        } 

        switch(tipo) {
            case "N": contentAP.getEstados().addAll(lista);  break;
            case "T": contentAP.getAlfabeto().addAll(lista); break;
            case "I": contentAP.setEstadoInicial(lista.get(0));break;
            case "A": contentAP.getEstadosAceptacion().addAll(lista); break;
            case "P": contentAP.getSimboloPila().addAll(lista); break;
        }
    }
    

    for (ArrayList<String> t : listAP ){
       
        contentAP.addTransicion(t);
    }
    RESULT = contentAP;
   
:} 

;
LIST_TRANSATIONS_AP ::= LIST_ID_TRANSACTIONS_AP:lita LIST_TRANSACTIONSP_AP:litap
{:
    


    ArrayList<ArrayList<String>> tmp = new ArrayList<>();
    tmp.addAll(lita); 
    if (litap != null){
        tmp.addAll(litap);
    }
   
    RESULT = tmp;
:}
;
LIST_TRANSACTIONSP_AP ::= LIST_ID_TRANSACTIONS_AP:lidta LIST_TRANSACTIONSP_AP:lidtap 
{:
    
    ArrayList<ArrayList<String>> tmp = new ArrayList<ArrayList<String>>();
    tmp.addAll(lidta);
    if (lidtap != null){
        tmp.addAll(lidtap);
    }
    RESULT = tmp;
:}
| 
{:
    RESULT = new ArrayList<ArrayList<String>>();
:}

;
LIST_ID_TRANSACTIONS_AP ::= ID_TRANSACTIONS_AP:ita
{:
   
    RESULT = ita;
:}
;
ID_TRANSACTIONS_AP ::= ID:i PAR_OPEN SYMBOLS:sym1 PAR_CLOSE PROD PAR_OPEN SYMBOLS:sym2 PAR_CLOSE COMMA SYMBOLS:sym3 COLON PAR_OPEN SYMBOLS:sym4 PAR_CLOSE LIST_OR_BEFORE_AP:listap SEMICOLON 
{:
    
    ArrayList<ArrayList<String>> tmp = new ArrayList<>();
    ArrayList<String> arr = new ArrayList<>();
    arr.add(i);
    arr.add(sym1);
    arr.add(sym2);
    arr.add(sym3);
    arr.add(sym4);
    

    if(listap != null && !listap.isEmpty()){
        for(ArrayList<String> alt : listap){
            arr.addAll(alt);
        }
    } 

    tmp.add(arr);

    RESULT = tmp;
:}
;
SYMBOLS ::= ID:i {: RESULT = i; :} | DOLLAR:d {: RESULT = d; :} | HASTAG:h {: RESULT = h; :}
;
LIST_OR_BEFORE_AP ::= OR LIST_STACK_AP:lap LIST_OR_BEFORE_AP:lobp 
{:
    
    ArrayList<ArrayList<String>> result = new ArrayList<>();
    result.add(new ArrayList<>(lap));   
    if (lobp != null){
        result.addAll(lobp);            
    }
    RESULT = result;
:}
|
{:
    RESULT = new ArrayList<ArrayList<String>>(); 
:}
;
LIST_STACK_AP ::= STATE_STACK_AP:ssa LIST_STACKP_AP:lsap
{:
    
    ArrayList<String> tmp = new ArrayList<String>();
    tmp.addAll(ssa);
    if (lsap != null){
        tmp.addAll(lsap);
    }
   
    RESULT = tmp;
:} 
;
LIST_STACKP_AP ::= STATE_STACK_AP:ssa LIST_STACKP_AP:lsap 
{:
   
    ArrayList<String> tmp = new ArrayList<String>();
    tmp.addAll(ssa);
    if (lsap != null){
        tmp.addAll(lsap);
    }
   
    RESULT = tmp;
:} 
| 
{:
    RESULT = new ArrayList<String>();
:} 
;
STATE_STACK_AP ::= PAR_OPEN SYMBOLS:in PAR_CLOSE PROD PAR_OPEN SYMBOLS:pop PAR_CLOSE COMMA SYMBOLS:next COLON PAR_OPEN SYMBOLS:push PAR_CLOSE
{:
    ArrayList<String> transicion = new ArrayList<>();
    transicion.add(in);     
    transicion.add(pop);    
    transicion.add(next);   
    transicion.add(push);   
    RESULT = transicion;
:}
;


LIST_CONFIG ::= LIST_AFD:cfg LIST_CONFIGP:cfgp
{:
    
    ArrayList<String[]> tmp = new ArrayList<>();
    if(cfg != null){
        tmp.addAll(cfg);
    }
    
    if(cfgp != null){
        tmp.addAll(cfgp);
    }
    RESULT = tmp;
:}
;
LIST_CONFIGP ::= LIST_AFD:cfg LIST_CONFIGP:cfgp 
{:

    ArrayList<String[]> tmp = new ArrayList<>();
    if(cfg != null){
        tmp.addAll(cfg);
    }
    
    if(cfgp != null){
        tmp.addAll(cfgp);
    }
    RESULT = tmp;
:}
| 
{:
    RESULT = new ArrayList<String[]>();
:}
;
LIST_AFD ::= ID_ASIGN:cfg
{:  
    ArrayList<String[]> list = new ArrayList<>();
    if(cfg != null){
        list.add(cfg);
    }
    
    RESULT = list;
    
    
    
:}
;
ID_ASIGN ::= ID:i EQUAL KEY_OPEN LIST_IDS:list KEY_CLOSE SEMICOLON 
{:
    String[] arr = new String[list.size() +1 ];
    arr[0] = i;
    
    for(int idx = 0; idx < list.size(); idx++){
        arr[idx+1] = list.get(idx);
    }
   
    RESULT = arr;
    
:}

;
LIST_IDS ::= STATE_ASSING:s STATE_ASIGNP:p
{:
    ArrayList<String> tmp = new ArrayList<String>();
    tmp.add(s);
    if(p != null){
        tmp.addAll(p);
    }
    RESULT = tmp;
:}
;
STATE_ASSING ::= ID:i {: RESULT = i; :}| INTEGER:num {: RESULT = num; :} | HASTAG:h {: RESULT = h; :} | DOLLAR:d{: RESULT = d; :}
;
STATE_ASIGNP ::= COMMA STATE_ASSING:s STATE_ASIGNP:p 
{:
    ArrayList<String> tmp = new ArrayList<String>();
    tmp.add(s);
    if(p != null){
        tmp.addAll(p);
    }
    RESULT = tmp;
:} 
|
{:
    RESULT = new ArrayList<String>();
:}
 
;
LIST_TRANSATIONS ::= LIST_ID_TRANSACTIONS:h LIST_TRANSACTIONSP:t
{:
    ArrayList<ArrayList<String>> tmp = new ArrayList<ArrayList<String>>();
    tmp.add(h);
    if (t != null){
        tmp.addAll(t);
    }
    RESULT = tmp;
:}
;
LIST_TRANSACTIONSP ::= LIST_ID_TRANSACTIONS:h LIST_TRANSACTIONSP:t 
{:
    ArrayList<ArrayList<String>> tmp = new ArrayList<ArrayList<String>>();
    tmp.add(h);
    if (t != null){
        tmp.addAll(t);
    }
    RESULT = tmp;
:}
| 
{:
    RESULT =  new ArrayList<ArrayList<String>>();
:}
;
LIST_ID_TRANSACTIONS ::= ID_TRANSACTIONS:tr
{:
    RESULT = tr;
:}
;
ID_TRANSACTIONS ::= ID:i PROD LIST_FOLLOWS:f LIST_OR_BEFORE:o SEMICOLON
{:
    ArrayList<String> tmp = new ArrayList<String>();
    tmp.add(i);
    if (f != null){
        tmp.addAll(f);
    }
    if (o != null){
        tmp.addAll(o);
    }
    
    RESULT = tmp;
:}
;
LIST_OR_BEFORE ::= OR LIST_FOLLOWS:f LIST_OR_BEFORE:lf 
{:
    ArrayList<String> tmp = new ArrayList<String>();

    tmp.addAll(f);
    if (lf != null){
        tmp.addAll(lf);
    }
   
    RESULT = tmp;
:}
| 
{:
    RESULT =  new ArrayList<String>();
:}
;
LIST_FOLLOWS ::= STATE_FOLLOWS:s STATE_FOLLOWSP:sp 
{:
    ArrayList<String> tmp = new ArrayList<String>();
    tmp.add(s);
    if (sp != null){
        tmp.addAll(sp);
    }
   
    RESULT = tmp;
:}
;
STATE_FOLLOWSP ::= COMMA STATE_FOLLOWS:sf STATE_FOLLOWSP:sfp
{:
    ArrayList<String> tmp = new ArrayList<String>();
    tmp.add(sf);
    if (sfp != null){
        tmp.addAll(sfp);
    }
   
    RESULT = tmp;
:} 
| 
{:
    RESULT =  new ArrayList<String>();
:}
;
STATE_FOLLOWS ::= ID:i {: RESULT = i; :} | INTEGER:num {: RESULT = num; :} 
;
AFD_CLOSE ::=   LESS CLOSE R_AFD GREATHER
| error 
{:
    sintax.skipCurrentDeclaration = true;
:}
;
AP_CLOSE ::= LESS CLOSE R_AP GREATHER
| error 
{:
    sintax.skipCurrentDeclaration = true;
:}
;
