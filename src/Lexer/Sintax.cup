parser code  
{:
    

    public static ArrayList<AFD> listaAFD = new ArrayList<>();
    public ArrayList<AFD> getListaAFD(){
        return listaAFD;
    }
    private Symbol s;
    public void syntax_error(Symbol s){
        String lexeme = (s.value != null) ? s.value.toString() : "EOF";
        
        Modelo.ModeloMenu.ListaErrores.add(new Modelo.Errors("Sintactico - Recuperado", lexeme, s.left+1 , s.right));
        
    }

    public void getS(Symbol s) throws java.lang.Exception {
        Modelo.ModeloMenu.ListaErrores.add(new Modelo.Errors("Sintactico - Sin recuperacion", (String)s.value, s.left+1 , s.right));
    }

    

:};
action code
{::};
