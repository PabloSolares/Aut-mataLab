ID_TRANSACTIONS_AP ::= ID PAR_OPEN SYMBOLS PAR_CLOSE PROD PAR_OPEN SYMBOLS PAR_CLOSE COMMA SYMBOLS COLON PAR_OPEN SYMBOLS PAR_CLOSE LIST_OR_BEFORE_AP:listap SEMICOLON
{:
    System.out.println("HOLAA DESDE AQUI TRANSICIONES 3.5 ");
