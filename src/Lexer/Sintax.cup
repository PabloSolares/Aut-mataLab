SYMBOLS ::= ID:i {: RESULT = i; :} | DOLLAR:d {: RESULT = d; :} | HASTAG:h {: RESULT = h; :}
;
LIST_OR_BEFORE_AP ::= OR LIST_STACK_AP:lap LIST_OR_BEFORE_AP:lobp 
{:
    System.out.println("HOLAA DESDE AQUI TRANSICIONES 4 ");
    ArrayList<ArrayList<String>> list = new ArrayList<ArrayList<String>>();
    ArrayList<String> alt = new ArrayList<String>(lap);

    list.add(alt);
    if (lobp != null){
        list.addAll(lobp);
    }
   
    RESULT = list;
:}
|
{:
