digraph AFD_Par1 {
rankdir=LR;
node [shape=circle];
  graph [labelloc=t, label="Automata: AFD_Par1\nTipo: Automata Finito Determinista\nEstados: [S, A]\nAlfabeto: [0, 1]\nEstado Inicial: S\nEstados de Aceptación: [S]\nTransiciones: S -> 0, S | 1, A |  
 	 	A -> 0, A | 1, S |  
 	 	S -> 0, S | 1, A |  
 	 	A -> 0, A | 1, S |  
 	 	", fontsize=18];
  _ini [shape=point,label=""];
 _ini -> "S";
  "S" [shape=doublecircle];
  "S" -> "S" [label="0"];
  "S" -> "A" [label="1"];
  "A" -> "A" [label="0"];
  "A" -> "S" [label="1"];
}
