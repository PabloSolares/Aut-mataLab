"P0" [label="P"];
"F0" [label="F" peripheries=2];
"I0" -> "P0" [label="$, $ → #"];
"P0" -> "P0" [label="a, $ → a"];
"P0" -> "P0" [label="b, a → $"];
"P0" -> "F0" [label="$, # → $"];
}
