package Lexer;
import java_cup.runtime.Symbol;
parser code  
{:
    private Symbol s;
    public void syntax_error(Symbol s){
        this.s = s;
    }

    public Symbol getS(){
        return this.s;
    }

:};

terminal LESS, R_AFD, R_NAME, EQUAL, STRING, GREATHER, COLON, ID,R_AP, KEY_OPEN, KEY_CLOSE, SEMICOLON, PROD, OR, CLOSE, R_TRANSICIONES, PAR_OPEN, PAR_CLOSE, DOLLAR, HASTAG, INTEGER ,DOT, COMMA,QUOTATION, ERROR;
non terminal PROGRAM, SYMBOLS,LIST_STACK_AP,STATE_STACK_AP,LIST_STACKP_AP, Syntax_AFD, Syntax_AP_P , LIST_TRANSATIONS_AP, LIST_TRANSACTIONSP_AP, LIST_ID_TRANSACTIONS_AP, ID_TRANSACTIONS_AP,LIST_OR_BEFORE_AP,  CONTENT_AFD, LIST_CONFIG, LIST_CONFIGP, LIST_AFD, ID_ASIGN, LIST_IDS, STATE_ASSING, STATE_ASIGNP, LIST_TRANSATIONS, LIST_TRANSACTIONSP, LIST_ID_TRANSACTIONS, ID_TRANSACTIONS, LIST_OR_BEFORE, LIST_FOLLOWS, STATE_FOLLOWSP, STATE_FOLLOWS, AFD_CLOSE, Syntax_AP, AP_CLOSE, CONTENT_AP ;

start with PROGRAM;

PROGRAM ::= Syntax_AFD | Syntax_AP_P
;
Syntax_AP_P ::= Syntax_AP
;
Syntax_AFD ::= LESS R_AFD R_NAME EQUAL STRING GREATHER CONTENT_AFD AFD_CLOSE 
;
Syntax_AP ::= LESS R_AP R_NAME EQUAL STRING GREATHER CONTENT_AP AP_CLOSE
;
CONTENT_AFD ::= LIST_CONFIG  R_TRANSICIONES COLON LIST_TRANSATIONS
;
CONTENT_AP ::= LIST_CONFIG  R_TRANSICIONES COLON LIST_TRANSATIONS_AP 
;
LIST_TRANSATIONS_AP ::= LIST_ID_TRANSACTIONS_AP LIST_TRANSACTIONSP_AP
;
LIST_TRANSACTIONSP_AP ::= LIST_ID_TRANSACTIONS_AP LIST_TRANSACTIONSP_AP | 
;
LIST_ID_TRANSACTIONS_AP ::= ID_TRANSACTIONS_AP
;
ID_TRANSACTIONS_AP ::= ID PAR_OPEN SYMBOLS PAR_CLOSE PROD PAR_OPEN SYMBOLS PAR_CLOSE COMMA SYMBOLS COLON PAR_OPEN SYMBOLS PAR_CLOSE LIST_OR_BEFORE_AP SEMICOLON
;
SYMBOLS ::= ID | DOLLAR | HASTAG
;
LIST_OR_BEFORE_AP ::= OR LIST_STACK_AP LIST_OR_BEFORE_AP |
; 
LIST_STACK_AP ::= STATE_STACK_AP LIST_STACKP_AP 
;
LIST_STACKP_AP ::= STATE_STACK_AP LIST_STACKP_AP | 
;
STATE_STACK_AP ::= PAR_OPEN SYMBOLS PAR_CLOSE PROD PAR_OPEN SYMBOLS PAR_CLOSE COMMA SYMBOLS COLON PAR_OPEN SYMBOLS PAR_CLOSE 
;
LIST_CONFIG ::= LIST_AFD LIST_CONFIGP
;
LIST_CONFIGP ::= LIST_AFD LIST_CONFIGP | 
;
LIST_AFD ::= ID_ASIGN 
;
ID_ASIGN ::= ID EQUAL KEY_OPEN LIST_IDS KEY_CLOSE SEMICOLON
;
LIST_IDS ::= STATE_ASSING STATE_ASIGNP
;
STATE_ASSING ::= ID | INTEGER | HASTAG | DOLLAR
;
STATE_ASIGNP ::= COMMA STATE_ASSING STATE_ASIGNP | 
;
LIST_TRANSATIONS ::= LIST_ID_TRANSACTIONS LIST_TRANSACTIONSP
;
LIST_TRANSACTIONSP ::= LIST_ID_TRANSACTIONS LIST_TRANSACTIONSP | 
;
LIST_ID_TRANSACTIONS ::= ID_TRANSACTIONS
;
ID_TRANSACTIONS ::= ID PROD LIST_FOLLOWS LIST_OR_BEFORE SEMICOLON
;
LIST_OR_BEFORE ::= OR LIST_FOLLOWS LIST_OR_BEFORE | 
;
LIST_FOLLOWS ::= STATE_FOLLOWS STATE_FOLLOWSP 
;
STATE_FOLLOWSP ::= COMMA STATE_FOLLOWS STATE_FOLLOWSP | 
;
STATE_FOLLOWS ::= ID | INTEGER 
;
AFD_CLOSE ::= LESS CLOSE R_AFD GREATHER
;
AP_CLOSE ::= LESS CLOSE R_AP GREATHER
;