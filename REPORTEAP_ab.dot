digraph AP_ab {
  rankdir=LR;
  node [shape=circle];
  graph [labelloc=t, label="Automata: AP_ab\nTipo: Automata de Pila\nEstados: [I, P, F]\nAlfabeto: [a, b]\nSimbolos Pila: [a, #]\nEstado Inicial: I\nEstados Aceptación: [F]\nTransiciones: {I=[($,$) -> (P,#)], P=[(a,$) -> (P,a), (b,a) -> (P,$), ($,#) -> (F,$)]}" fontsize=18];
  _ini [shape=point,label=""];
  _ini -> "I";
  "F" [shape=doublecircle];
  "I" -> "P" [label="$, $ → #"];
  "P" -> "P" [label="a, $ → a"];
  "P" -> "P" [label="b, a → $"];
  "P" -> "F" [label="$, # → $"];
}
